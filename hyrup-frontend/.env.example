# Copy this file to .env and fill in your values. NEVER commit .env with real secrets.

# Dashboard login credentials
VITE_APP_USERNAME=admin
VITE_APP_PASSWORD=your_password_here

# API key — must match HYRUP_API_KEY on the backend
VITE_API_KEY=your_api_key_here

# Backend URL — set this to your Railway deployment URL
# This is used for ALL API calls AND the WebSocket (live stream)
VITE_BACKEND_URL=https://your-app.up.railway.app

# Local dev only — use this instead of VITE_BACKEND_URL when running locally
# VITE_API_URL=http://127.0.0.1:5001
